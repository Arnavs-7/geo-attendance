# ── Firebase Web App config ──────────────────────────────────────────────
# These are PUBLIC by design (Firebase web API keys are not secrets — access
# is controlled by Firestore Security Rules). Copy from:
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Office geofence fallback defaults ────────────────────────────────────
# Used ONLY if the `officeConfig/default` Firestore document is missing.
# In normal operation, an admin manages these from /admin/settings.
NEXT_PUBLIC_OFFICE_LAT=12.9716
NEXT_PUBLIC_OFFICE_LNG=77.5946
NEXT_PUBLIC_GEOFENCE_RADIUS_METERS=100

# ── App meta ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=production

# NOTE: This app runs entirely on the Firebase Spark (free) plan and Vercel
# Hobby. There is NO Firebase Admin SDK / Cloud Functions — no server-side
# service-account keys are required.
